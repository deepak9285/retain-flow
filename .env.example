# RetainFlow Environment Variables
# Copy this file to .env and fill in your values.
# Never commit your .env file to version control.

# ─── Supabase Auth (Required for production) ────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API
# Without these, the app runs in Demo Mode with a hardcoded dev login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Google Sheets read-only OAuth ──────────────────────────────────────────────
# Create a Web OAuth client in Google Cloud Console and add your app origin.
# The spreadsheet ID is configured for the RetainFlow_Demo_Data sheet.
VITE_GOOGLE_CLIENT_ID=36370331900-coqv0vp20fbmr7o4jd7e78cjsqgna9n1.apps.googleusercontent.com

# ─── n8n (Configured via Settings UI, not here) ─────────────────────────────────
# The n8n webhook URL is configured in the app's Settings page and stored
# in browser localStorage. It is NOT stored here.
#
# Your Meta WhatsApp Cloud API access token must be stored ONLY inside n8n.
# It must NEVER appear in this file or in any frontend code.
